################################################################################
# PRODUCTION ENVIRONMENT - CLOUDFLARE DEPLOYMENT
################################################################################
# This file contains production-specific environment variables
# Copy to .env.production and fill with actual production values
#
# Security Checklist:
#   ✓ All secrets generated and unique
#   ✓ Database password is strong (20+ characters)
#   ✓ SSL enabled for database connections
#   ✓ CORS configured for specific domains only
#   ✓ Rate limiting enabled
#   ✓ Admin path changed from default
#   ✓ Debug and playground disabled
#   ✓ Use Cloudflare R2 for uploads (not local storage)
################################################################################

# Application
NODE_ENV=production
HOST=0.0.0.0
PORT=1337

# Public URL - UPDATE WITH YOUR SUBDOMAIN
PUBLIC_URL=https://api.yourdomain.com
ADMIN_PATH=/secure-admin

# Database - Use managed PostgreSQL service
# Recommended: Neon, Supabase, CloudSQL, RDS, or Cloudflare D1
DATABASE_CLIENT=postgres
DATABASE_HOST=your-postgres-host.region.provider.com
DATABASE_PORT=5432
DATABASE_NAME=strapi_production
DATABASE_USERNAME=strapi_prod_user
DATABASE_PASSWORD=USE_STRONG_PASSWORD_FROM_SECRETS_MANAGER
DATABASE_SSL=true

# Alternative: Cloudflare D1 (SQLite)
# DATABASE_CLIENT=better-sqlite3
# DATABASE_FILENAME=/data/production.db

# Security Secrets - MUST BE UNIQUE AND SECURE
JWT_SECRET=__SET_VIA_WRANGLER_SECRETS__
ADMIN_JWT_SECRET=__SET_VIA_WRANGLER_SECRETS__
API_TOKEN_SALT=__SET_VIA_WRANGLER_SECRETS__
TRANSFER_TOKEN_SALT=__SET_VIA_WRANGLER_SECRETS__
APP_KEYS=__SET_VIA_WRANGLER_SECRETS__

# Cloudflare Configuration
CF_ACCOUNT_ID=your_actual_account_id
CF_ZONE_ID=your_actual_zone_id
CF_API_TOKEN=__SET_VIA_WRANGLER_SECRETS__

# Cloudflare R2 for file uploads (recommended for production)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=__SET_VIA_WRANGLER_SECRETS__
R2_SECRET_ACCESS_KEY=__SET_VIA_WRANGLER_SECRETS__
R2_BUCKET_NAME=strapi-production-uploads
R2_PUBLIC_URL=https://uploads.yourdomain.com

# CORS - Specify exact domains
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Security
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_DURATION=60000

# File Uploads
MAX_FILE_SIZE=104857600
UPLOAD_PROVIDER=cloudflare-r2

# Email - Use production email service
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=__SET_VIA_WRANGLER_SECRETS__
EMAIL_FROM=noreply@yourdomain.com
EMAIL_REPLY_TO=support@yourdomain.com

# Logging
LOG_LEVEL=error
LOG_QUERIES=false

# Error Tracking
SENTRY_DSN=__SET_VIA_WRANGLER_SECRETS__

# Performance
COMPRESSION_ENABLED=true
RESPONSE_CACHE_TIME=3600

# Disable development features
GRAPHQL_PLAYGROUND=false
API_DOCS_ENABLED=false
DEBUG=false

################################################################################
# HOW TO SET SECRETS IN CLOUDFLARE
################################################################################
# Use wrangler to set sensitive values as secrets:
#
# wrangler secret put JWT_SECRET
# wrangler secret put ADMIN_JWT_SECRET
# wrangler secret put API_TOKEN_SALT
# wrangler secret put TRANSFER_TOKEN_SALT
# wrangler secret put APP_KEYS
# wrangler secret put DATABASE_PASSWORD
# wrangler secret put CF_API_TOKEN
# wrangler secret put R2_ACCESS_KEY_ID
# wrangler secret put R2_SECRET_ACCESS_KEY
# wrangler secret put SENDGRID_API_KEY
# wrangler secret put SENTRY_DSN
################################################################################
