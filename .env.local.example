################################################################################
# LOCAL DEVELOPMENT ENVIRONMENT
################################################################################
# This file contains local development environment variables
# Copy to .env or .env.local and customize for your local setup
#
# Local Development Features:
#   - SQLite database (no PostgreSQL required)
#   - Debug mode enabled
#   - Hot reload enabled
#   - GraphQL Playground enabled
#   - API documentation enabled
#   - Less strict CORS
#   - Local file uploads
################################################################################

# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=1337

# Public URL - Use localhost for local development
PUBLIC_URL=http://localhost:1337
ADMIN_PATH=/admin

# Database - SQLite for easy local development
# No database server required!
DATABASE_CLIENT=better-sqlite3
DATABASE_FILENAME=.tmp/data.db

# Alternative: Use Docker Compose PostgreSQL
# Uncomment below and run: docker-compose up postgres
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi_dev
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SSL=false

# Security Secrets - Development only, regenerate for production
# These are sample values - OK for local dev, NEVER for production
JWT_SECRET=dev_jwt_secret_not_for_production_use_only
ADMIN_JWT_SECRET=dev_admin_jwt_secret_not_for_production
API_TOKEN_SALT=dev_api_token_salt_not_for_production
TRANSFER_TOKEN_SALT=dev_transfer_token_salt_not_for_production
APP_KEYS=dev_key1,dev_key2,dev_key3,dev_key4

# CORS - Allow all origins in development
CORS_ORIGINS=*

# Security - More lenient for development
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_DURATION=60000

# File Uploads - Local storage
MAX_FILE_SIZE=209715200
UPLOAD_PROVIDER=local
UPLOAD_PATH=./public/uploads

# Email - Use console output or Ethereal for testing
EMAIL_PROVIDER=sendmail
EMAIL_FROM=dev@localhost
EMAIL_REPLY_TO=dev@localhost

# Logging - Verbose for debugging
LOG_LEVEL=debug
LOG_QUERIES=true

# Development Features - All enabled
GRAPHQL_PLAYGROUND=true
API_DOCS_ENABLED=true
DEBUG=true

# Performance - Disable for faster development
COMPRESSION_ENABLED=false

# No external services needed for local development
# SENTRY_DSN=
# CF_ACCOUNT_ID=
# CF_ZONE_ID=

################################################################################
# QUICK START FOR LOCAL DEVELOPMENT
################################################################################
# 1. Copy this file:
#    cp .env.local.example .env
#
# 2. Install dependencies:
#    npm install
#
# 3. Start Strapi:
#    npm run develop
#
# 4. Access at:
#    http://localhost:1337/admin
#
# SQLite database will be created automatically at .tmp/data.db
################################################################################

################################################################################
# TESTING WITH DOCKER COMPOSE
################################################################################
# To test with PostgreSQL using Docker:
#
# 1. Update DATABASE_CLIENT to postgres
# 2. Run: docker-compose up -d postgres
# 3. Run: npm run develop
#
# This simulates production database setup locally
################################################################################
